@page "/"

<div class="container py-4">
    <h1 class="mb-2">Habit Tracker</h1>
    <p class="text-muted">En enkel MVP for vaner, streaks og rewards.</p>

    <div class="row g-3 mt-2">
        <div class="col-12 col-md-6">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Habits</h5>
                    <p class="card-text">Marker vaner i en 7-dagers oversikt og bygg streaks.</p>
                    <a class="btn btn-primary" href="/habits">Åpne Habits</a>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Rewards</h5>
                    <p class="card-text">Lag belønninger og lås dem opp med poeng.</p>
                    <a class="btn btn-primary" href="/rewards">Åpne Rewards</a>
                </div>
            </div>
        </div>
    </div>

    @* TODO : dashboard med "dagens poeng", "neste reward", og ukesstatistikk *@
</div>
