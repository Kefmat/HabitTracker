@page "/rewards"
@inject HabitTracker.Services.HabitService HabitService

<h3>Rewards</h3>

<p><b>Poeng totalt:</b> @pointsAllTime</p>

<div style="display:flex; gap:8px; align-items:center; margin-bottom:12px;">
    <input @bind="newRewardName" placeholder="Ny reward" style="min-width:240px;" />
    <input @bind="newRewardCost" type="number" style="width:120px;" />
    <button class="btn btn-primary" @onclick="AddRewardAsync">Add</button>
</div>

@if (rewards.Count == 0)
{
    <p style="opacity:.7;">Ingen rewards ennå — legg til en over.</p>
}
else
{
    <table class="table table-sm align-middle">
        <thead>
            <tr>
                <th>Reward</th>
                <th>Kost</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in rewards)
            {
                var unlocked = unlockedIds.Contains(r.Id);

                <tr>
                    <td><b>@r.Name</b></td>
                    <td>@r.CostPoints</td>
                    <td>
                        @if (unlocked)
                        {
                            <span class="badge text-bg-success">Unlocked</span>
                        }
                        else
                        {
                            <span class="badge text-bg-secondary">Locked</span>
                        }
                    </td>
                    <td style="text-align:right; width:60px;">
                        <button class="btn btn-sm btn-outline-danger" title="Slett"
                                @onclick="() => DeleteRewardAsync(r.Id)">
                            🗑️
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<HabitTracker.Models.Reward> rewards = new();
    private HashSet<Guid> unlockedIds = new();
    private int pointsAllTime;

    private string newRewardName = "";
    private int newRewardCost = 100;

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        pointsAllTime = await HabitService.TotalPointsAllTimeAsync();
        rewards = await HabitService.GetRewardsAsync();
        unlockedIds = await HabitService.GetUnlockedRewardIdsAsync();

        // TODO (senere): vis "neste reward" + progress bar (poeng igjen).
        // TODO (senere): "claim reward" knapp / historikk over unlocks.
    }

    private async Task AddRewardAsync()
    {
        await HabitService.AddRewardAsync(newRewardName, newRewardCost);
        newRewardName = "";
        newRewardCost = 100;
        await ReloadAsync();
    }

    private async Task DeleteRewardAsync(Guid id)
    {
        await HabitService.DeleteRewardAsync(id);
        await ReloadAsync();
    }
}
