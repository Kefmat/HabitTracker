@page "/rewards"
@inject HabitTracker.Services.HabitService HabitService
@inject IJSRuntime JS

<PageWrapper Title="Rewards" Subtitle="Sett belønninger og lås dem opp med poeng.">

@if (!string.IsNullOrWhiteSpace(feilMelding))
{
    <div class="alert alert-warning" role="alert">
        @feilMelding
    </div>
}

@if (progress is not null)
{
    <div class="card mb-3">
        <div class="card-body">
            <h5 class="card-title">Fremdrift mot neste reward</h5>

            <p class="mb-2"><b>Poeng totalt:</b> @progress.TotalPoints</p>

            @if (progress.NextReward is null)
            {
                <p class="mb-0">🎉 Ingen neste reward (enten ingen rewards, eller alle er låst opp).</p>
            }
            else
            {
                <p class="mb-2">
                    <b>Neste reward:</b> @progress.NextReward.Name
                    <span class="text-muted">(@progress.NextReward.CostPoints poeng)</span>
                </p>

                <div class="progress mb-2" style="height: 18px;">
                    <div class="progress-bar" role="progressbar"
                         style="width: @progress.Percent%"
                         aria-valuenow="@progress.Percent" aria-valuemin="0" aria-valuemax="100">
                        @progress.Percent%
                    </div>
                </div>

                <p class="mb-0"><b>Mangler:</b> @progress.PointsToNext poeng</p>
            }
        </div>
    </div>
}

<div class="d-flex flex-wrap gap-2 align-items-center mb-3">
    <input class="form-control"
           style="max-width: 320px;"
           @bind="newRewardName"
           @bind:event="oninput"
           placeholder="Ny reward" />

    <input class="form-control"
           style="max-width: 160px;"
           @bind="newRewardCost"
           type="number" />

    <button class="btn btn-primary"
            @onclick="AddRewardAsync"
            disabled="@IsAddDisabled">
        Legg til
    </button>
</div>

@if (rewards.Count == 0)
{
    <p class="text-muted">Ingen rewards ennå — legg til en over.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-sm align-middle">
            <thead>
                <tr>
                    <th>Reward</th>
                    <th>Kost</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in rewards)
                {
                    var unlocked = unlockedIds.Contains(r.Id);

                    <tr>
                        <td><b>@r.Name</b></td>
                        <td>@r.CostPoints</td>
                        <td>
                            @if (unlocked)
                            {
                                <span class="badge text-bg-success">Unlocked</span>
                            }
                            else
                            {
                                <span class="badge text-bg-secondary">Locked</span>
                            }
                        </td>
                        <td class="text-end" style="width:60px;">
                            <button class="btn btn-sm btn-outline-danger"
                                    title="Slett"
                                    @onclick="() => ConfirmDeleteReward(r.Id)">
                                🗑️
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<HabitTracker.Models.Reward> rewards = new();
    private HabitTracker.Models.RewardProgress? progress;
    private HashSet<Guid> unlockedIds = new();
    private int pointsAllTime;

    private string newRewardName = "";
    private int newRewardCost = 100;

    private string feilMelding = "";
    private bool IsAddDisabled => string.IsNullOrWhiteSpace(newRewardName);

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        pointsAllTime = await HabitService.TotalPointsAllTimeAsync();
        rewards = await HabitService.GetRewardsAsync();
        unlockedIds = await HabitService.GetUnlockedRewardIdsAsync();
        progress = await HabitService.GetRewardProgressAsync();

        // TODO (UX): legg til "claim reward"-knapp i stedet for auto-unlock.
        // TODO (historikk): vis når en reward ble låst opp.
        // TODO (balanse): skill mellom tilgjengelige poeng og all-time poeng.
    }

    private async Task AddRewardAsync()
    {
        feilMelding = "";

        if (string.IsNullOrWhiteSpace(newRewardName))
        {
            feilMelding = "Du må skrive inn et navn på reward før du kan legge den til.";
            return;
        }

        await HabitService.AddRewardAsync(newRewardName, newRewardCost);

        newRewardName = "";
        newRewardCost = 100;

        await ReloadAsync();
    }

    private async Task DeleteRewardAsync(Guid id)
    {
        await HabitService.DeleteRewardAsync(id);
        await ReloadAsync();
    }

    private async Task ConfirmDeleteReward(Guid id)
    {
        var ok = await JS.InvokeAsync<bool>(
            "confirm",
            "Er du sikker på at du vil slette denne rewarden?"
        );

        if (ok)
        {
            await DeleteRewardAsync(id);
        }
    }
}

</PageWrapper>
