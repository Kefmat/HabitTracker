@using HabitTracker.Components.Layout

@* Routeren finner alle komponenter med @page og matcher URL -> komponent *@
<Router AppAssembly="@typeof(Program).Assembly">
    <Found Context="routeData">
        @* DefaultLayout er "skallet" rundt sidene (meny, container osv.) *@
        <RouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)" />
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>

    <NotFound>
        <LayoutView Layout="@typeof(MainLayout)">
            <h1>Ikke funnet</h1>
            <p>Beklager, det finnes ingen side på denne adressen.</p>
        </LayoutView>
    </NotFound>
</Router>
